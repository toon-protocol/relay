# Copy to .env and fill in. Only the first four are required.
#
# Nothing here configures the CONNECTOR: it has no environment-variable layer,
# so every connector value lives in ./connector.toml and its keys are FILES you
# generate next to it (README step 2).

# ── Required ─────────────────────────────────────────────────────────────────
# The public hostname of the connector's client edge (paid writes).
EDGE_HOST=proxy.relay.example.com
# The public hostname of the relay's free NIP-01 WebSocket reads.
READ_HOST=relay-ws.example.com
# Where Let's Encrypt sends certificate-expiry notices.
ACME_EMAIL=you@example.com
# The relay's own Nostr IDENTITY — not money, and not the connector's keys.
# Generate: openssl rand -hex 32
# Keep it stable: it is the pubkey clients know this relay by.
RELAY_NOSTR_SECRET_KEY=

# ── The relay ────────────────────────────────────────────────────────────────
# true skips event-signature verification on writes. Smoke tests only.
RELAY_DEV_MODE=false
# true restores full schnorr verification for paid ephemeral kinds
# (20000-29999). The default false skips it, which is safe only because the
# relay's write port is reachable exclusively through the connector — see
# docker-compose.yml's privacy invariant. Set true if you front it otherwise.
RELAY_VERIFY_EPHEMERAL=false
# Max concurrent WebSocket read connections (one file descriptor each).
RELAY_MAX_CONNECTIONS=4096

# ── Retention (docs/retention.md) ────────────────────────────────────────────
# false is the kill switch: set it, restart, and every still-stored event is
# served again — which works only while the data is still on disk, hence the
# grace window below.
RELAY_ENFORCE_EXPIRATION=true
# How long an expired event survives on disk before the reaper deletes it.
RELAY_EXPIRATION_REAP_GRACE_SECONDS=86400
# How often the reaper sweeps. 0 disables the sweep entirely.
RELAY_EXPIRATION_REAP_INTERVAL_SECONDS=3600
# Comma-separated 64-hex EVENT IDS to refuse. Ids only, never pubkeys — read
# the hazard section of docs/retention.md first. Every entry is logged at
# startup.
RELAY_BLOCKED_EVENT_IDS=

# ── Free ephemeral write lane ────────────────────────────────────────────────
# This lane has no payment gate, so these bounds ARE its admission control.
# Widen only if legitimate presence/typing traffic is being rate-limited.
RELAY_EPHEMERAL_RATE_LIMIT=200
RELAY_EPHEMERAL_RATE_WINDOW_MS=10000
RELAY_EPHEMERAL_MAX_BODY_BYTES=8192

# ── Images ───────────────────────────────────────────────────────────────────
# The relay app image only. It defaults to `:release`, which moves on every
# green merge to this repo's main and is what the Watchtower overlay follows.
# Pin an immutable `:sha-<short>` tag here to hold a specific build or roll
# one back.
#
# The CONNECTOR is deliberately NOT settable here: it is pinned to an
# immutable tag directly in ./docker-compose.yml, next to the connector.toml
# it was validated against, so the two move in one reviewed commit and reach
# the box in one `git pull`. Adopting a newer connector means editing that
# `image:` line.
RELAY_IMAGE=ghcr.io/toon-protocol/relay:release
