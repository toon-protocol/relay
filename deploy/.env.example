# relay deploy — copy to .env. TLS is terminated by the deployment environment.
#
# NOTE: nothing here configures the CONNECTOR any more. Since the cutover to the
# Rust connector (connector#755) there is no environment-variable layer on that
# side at all — every connector value comes from ./connector.toml, and its two
# secrets are FILES you generate next to it (see README.md step 1). What remains
# below configures the relay app, the image pins, and the published ports.

# ── Identities ───────────────────────────────────────────────────────────────
# REQUIRED: relay Nostr identity (NOT money). Generate: openssl rand -hex 32
RELAY_NOSTR_SECRET_KEY=
# true skips Nostr signature verification on writes (smoke only).
RELAY_DEV_MODE=false
# false (default) skips schnorr verification for paid-ephemeral kinds
# (20000-29999) — safe ONLY because :3100 is reachable exclusively through the
# payment-gating connector (see docker-compose.yml's PRIVACY INVARIANT). Set
# true if you ever front :3100 with anything else.
RELAY_VERIFY_EPHEMERAL=false
# Max concurrent WS read connections (relay#90).
RELAY_MAX_CONNECTIONS=4096
#
# The connector's identities are NOT here. `TOON_MNEMONIC` used to derive the
# settlement key at boot and no longer does anything:
#   deploy/signer.key      — fresh random, this node's ILP identity, holds no money
#   deploy/settlement.key  — derived at NIP-06 m/44'/1237'/0'/0/0, spends value
# Both are gitignored and mounted read-only into the container.

# ── Images ───────────────────────────────────────────────────────────────────
# The connector image baked into relay-connector, but ONLY when you build it
# yourself (`docker compose up --build`). On the production path — pull
# RELAY_CONNECTOR_IMAGE, `up` without --build — this variable does NOTHING: no
# environment variable can change what is already baked into a pulled image,
# and what is baked in is deploy/Dockerfile's own ARG default at the commit CI
# built. To adopt a newer connector there, bump that ARG default and cut a new
# relay-connector release; bumping this line alone will not do it.
#
# Pin an exact `rust-sha-` tag, never the floating `rust-main`: the config
# parser is `deny_unknown_fields` and startup is fail-closed, so a schema
# drift is a refuse-to-start.
#
# The `connector` package holds BOTH lineages under one name. A plain semver tag
# (`3.28.0`, `latest`) is the RETIRED TypeScript node, which reads YAML and will
# not start on ./connector.toml. Only `rust-*` tags are this connector.
CONNECTOR_TAG=rust-sha-440eab7
# The published relay-connector image (prod: pin a tag and `up` without --build).
RELAY_CONNECTOR_IMAGE=ghcr.io/toon-protocol/relay-connector:latest
# The published relay app image.
RELAY_IMAGE=ghcr.io/toon-protocol/relay:latest

# ── Ports ────────────────────────────────────────────────────────────────────
# Host interface the published ports bind to. 127.0.0.1 (default) keeps both
# ports reachable only via the deployment environment's own TLS terminator;
# only widen this if you understand the exposure (see docker-compose.yml's
# PRIVACY INVARIANT comment) — never set this to 0.0.0.0.
BIND_ADDR=127.0.0.1
EDGE_PORT=3000
RELAY_WS_PORT=7100
