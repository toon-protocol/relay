{
  "name": "@toon-protocol/relay",
  "version": "2.0.2",
  "description": "Nostr relay app: free NIP-01 WebSocket reads + an HTTP POST /write surface",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "relay": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "import": "./dist/cli.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run"
  },
  "keywords": [
    "nostr",
    "relay",
    "toon",
    "nip-01",
    "nip-09",
    "nip-16",
    "nip-40",
    "websocket"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/toon-protocol/relay.git",
    "directory": "packages/relay"
  },
  "author": "ALLiDoizCode",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hono/node-server": "^1.0.0",
    "better-sqlite3": "^11.0.0",
    "hono": "^4.11.10",
    "nostr-tools": "^2.20.0",
    "tiny-secp256k1": "^2.2.4",
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/ws": "^8.0.0"
  }
}
