{
  "name": "relay",
  "version": "0.3.0",
  "private": true,
  "description": "TOON Protocol Nostr relay: free NIP-01 WebSocket reads + an HTTP POST /write surface",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:all": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write \"packages/*/**/*.{ts,mjs}\" \"deploy/*.ts\"",
    "format:check": "prettier --check \"packages/*/**/*.{ts,mjs}\" \"deploy/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sandcastle:ready": "npx tsx .sandcastle/ready-issues.ts",
    "sandcastle:implement": "npx tsx .sandcastle/agent-implement-issue.ts"
  },
  "keywords": [
    "nostr",
    "relay",
    "toon",
    "nip-01",
    "nip-09",
    "nip-16",
    "nip-40",
    "websocket"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@8.15.9",
  "pnpm": {
    "overrides": {
      "nostr-tools": "2.23.1"
    },
    "auditConfig": {
      "ignoreCves": [
        "GHSA-vjh7-7g9h-fjfh",
        "GHSA-848j-6mx2-7j84",
        "GHSA-w7fw-mjwx-w883",
        "GHSA-49q7-c7j4-3p7m",
        "GHSA-c2qf-rxjj-qqgw"
      ]
    }
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "0.12.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.11.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.2.0",
    "smol-toml": "^1.7.1",
    "tsx": "^4.19.2",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^1.0.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.0"
  }
}
